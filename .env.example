# Supabase -> Project Settings -> API keys

PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The "publishable key" (labelled "anon key" on older projects).
# Safe in the browser: it grants nothing on its own, RLS decides everything.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The "secret key" (labelled "service_role key" on older projects).
# Bypasses RLS entirely. Server-only - never rename this with a PUBLIC_ prefix.
# Imported by exactly one module: src/lib/server/plan-preview.ts
SUPABASE_SECRET_KEY=


# Migrations only (pnpm db:push). Not read by the app at runtime.
# Supabase -> Project Settings -> Database -> Database password
SUPABASE_DATABASE_PASSWORD=

# Host from the "Session pooler" connection string, minus the port.
# The pooler is used rather than db.<ref>.supabase.co because that host is IPv6-only on
# current projects, so it refuses connections from IPv4-only networks.
SUPABASE_DB_POOLER_HOST=aws-0-your-region.pooler.supabase.com
